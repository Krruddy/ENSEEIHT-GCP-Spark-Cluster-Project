logging:
  receivers:
    syslog:
      type: files
      include_paths:
        - /var/log/syslog
        - /var/log/messages

{% if 'spark_master' in group_names or 'spark_worker' in group_names %}
    spark_logs:
      type: files
      include_paths:
        - /opt/spark/logs/*.out
        - /opt/spark/logs/*.log
{% endif %}

{% if 'hadoop_master' in group_names or 'hadoop_worker' in group_names %}
    hdfs_logs:
      type: files
      include_paths:
        - /opt/hadoop/logs/*.log
        - /opt/hadoop/logs/*.out
{% endif %}

  processors:
    parse_json:
      type: parse_json
      field: message

  exporters:
    google:
      type: google_cloud_logging

  service:
    pipelines:
      default_pipeline:
        receivers: [syslog]
        processors: [parse_json]
        exporters: [google]

{% if 'spark_master' in group_names or 'spark_worker' in group_names %}
      spark_pipeline:
        receivers: [spark_logs]
        processors: [parse_json]
        exporters: [google]
{% endif %}

{% if 'hadoop_master' in group_names or 'hadoop_worker' in group_names %}
      hdfs_pipeline:
        receivers: [hdfs_logs]
        processors: [parse_json]
        exporters: [google]
{% endif %}

metrics:
  receivers:
    hostmetrics:
      type: hostmetrics
      collection_interval: 60s

  processors:
    metrics_filter:
      type: exclude_metrics
      metrics_pattern: []

  exporters:
    google:
      type: google_cloud_monitoring

  service:
    pipelines:
      default_pipeline:
        receivers: [hostmetrics]
        processors: [metrics_filter]
        exporters: [google]
