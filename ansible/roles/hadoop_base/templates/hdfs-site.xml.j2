<configuration>
    <property>
        <name>dfs.replication</name>
        <value>{{ hdfs_replication_factor }}</value>
    </property>
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///var/lib/hadoop/dfs/name</value>
    </property>
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///mnt/hdfs_data</value>
    </property>
</configuration>
